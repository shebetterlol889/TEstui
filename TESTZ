local function BuildSlider(card, spec)
	local row = BaseRow(card, spec.label, 58)
	local id = SpecId(card, spec)
	local minimum = spec.min or 0
	local maximum = spec.max or 100
	local step = spec.step or 1
	local value = tonumber(State[id])
	if value == nil then
		value = spec.default or minimum
	end
	value = math.clamp(value, minimum, maximum)
	State[id] = value
	local dragging = false

	Label(row, {
		Position = UDim2.fromOffset(13, 2),
		Size = UDim2.new(1, -92, 0, 27),
		Font = Enum.Font.GothamMedium,
		Text = spec.label,
		TextSize = 10,
		ZIndex = 9,
	})
	local valueLabel = Label(row, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -13, 0, 2),
		Size = UDim2.fromOffset(75, 27),
		Font = Enum.Font.GothamMedium,
		TextColor3 = Theme.Muted,
		TextSize = 9,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 9,
	})
	local track = New("TextButton", {
		Name = "Track",
		Position = UDim2.fromOffset(13, 37),
		Size = UDim2.new(1, -26, 0, 4),
		BackgroundColor3 = Theme.Track,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 10,
		Parent = row,
	})
	AddCorner(track, 4)
	for index = 1, 9 do
		local alpha = index / 10
		local tick = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(alpha, 0, 0.5, 0),
			Size = UDim2.fromOffset(2, 2),
			BackgroundColor3 = Color3.fromRGB(113, 104, 118),
			BorderSizePixel = 0,
			ZIndex = 11,
			Parent = track,
		})
		AddCorner(tick, 2)
	end
	local fill = New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 12,
		Parent = track,
	})
	AddCorner(fill, 4)
	AddGradient(fill, Theme.AccentBright, Theme.Accent, 0)
	local knob = New("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		ZIndex = 13,
		Parent = track,
	})
	AddCorner(knob, 14)
	AddStroke(knob, Theme.AccentBright, 0.2, 1)

	local function formatValue(nextValue)
		if spec.formatter then
			return spec.formatter(nextValue)
		end
		if step < 1 then
			return string.format("%.1f%s", nextValue, spec.suffix or "")
		end
		return tostring(math.floor(nextValue + 0.5)) .. (spec.suffix or "")
	end

	local function set(nextValue, fireCallback)
		local numeric = math.clamp(tonumber(nextValue) or minimum, minimum, maximum)
		numeric = minimum + math.floor(((numeric - minimum) / step) + 0.5) * step
		numeric = math.clamp(numeric, minimum, maximum)
		value = numeric
		State[id] = value
		local alpha = maximum == minimum and 0 or (value - minimum) / (maximum - minimum)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		valueLabel.Text = formatValue(value)
		if fireCallback ~= false and spec.callback then
			spec.callback(value)
		end
	end

	local function setFromX(x)
		local width = math.max(track.AbsoluteSize.X, 1)
		local alpha = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
		set(minimum + (maximum - minimum) * alpha, true)
	end

	Connect(track.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	Connect(UserInputService.InputChanged, function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
		) then
			setFromX(input.Position.X)
		end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	set(value, false)
	RegisterControl(id, spec.default or minimum, set, function()
		return value
	end)
end

