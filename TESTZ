			Size = UDim2.new(1, -20, 0, 1),
			BackgroundColor3 = Theme.Stroke,
			BorderSizePixel = 0,
			ZIndex = 7,
			Parent = frame,
		})
		self.Cursor += 10
		UpdateHeight()
	end

	function group:AddToggle(text, defaultValue, callback)
		local value = defaultValue == true
		local rowHeight = TouchMode and 40 or 31
		local toggleWidth = TouchMode and 42 or 36
		local toggleHeight = TouchMode and 22 or 18
		local knobSize = TouchMode and 14 or 12
		local knobInset = TouchMode and 4 or 3
