local function RemovePrevious(parent)
	local previous = parent and parent:FindFirstChild(ScreenGui.Name)
	if previous then
		previous:Destroy()
	end
	local legacy = parent and parent:FindFirstChild("ZyphoraInterface")
	if legacy then
		legacy:Destroy()
	end
end

