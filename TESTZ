Connect(DragArea.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		activeDragInput = input
		dragStart = input.Position
		startPosition = Main.Position
	end
end)

Connect(UserInputService.InputChanged, function(input)
	local isMouseDrag = activeDragInput and activeDragInput.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement
	local isTouchDrag = activeDragInput and activeDragInput.UserInputType == Enum.UserInputType.Touch
		and input == activeDragInput
	if dragging and (isMouseDrag or isTouchDrag) then
		local delta = input.Position - dragStart
		local proposed = UDim2.new(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
		local position = ClampPosition(proposed)
		Main.Position = position
		Shadow.Position = position
	end
end)

Connect(UserInputService.InputEnded, function(input)
	local endedMouse = activeDragInput and activeDragInput.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseButton1
	local endedTouch = activeDragInput and activeDragInput.UserInputType == Enum.UserInputType.Touch
		and input == activeDragInput
	if endedMouse or endedTouch then
		dragging = false
		activeDragInput = nil
	end
end)

Connect(UserInputService.InputBegan, function(input, gameProcessed)
	if not Alive or gameProcessed then
		return
	end

	if WaitingForKey and input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			Settings.ToggleKey = input.KeyCode
			WaitingForKey = false
			if KeybindButton then
				KeybindButton.Text = input.KeyCode.Name
				KeybindButton.TextColor3 = Theme.Text
			end
			Notify("Menu key", input.KeyCode.Name .. " now toggles the interface.")
		end
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Settings.ToggleKey then
		SetVisible(not MenuVisible)
	end
end)

