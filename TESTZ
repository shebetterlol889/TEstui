local function ApplyCosmeticSelection()
	local selectedWeapon = CosmeticBrowser.SelectedWeapon
	local selectedSkin = CosmeticBrowser.SelectedSkin
	if not selectedWeapon or not selectedSkin then
		Notify("Cosmetic changer", "Select a weapon and one of its skins first.")
		return
	end
	if not IsUnlockAllReady() then
		Notify("Cosmetic changer", "Press Unlock All Skins and wait for it to finish first.")
		return
	end
	local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
	local dataRemotes = remotes and remotes:FindFirstChild("Data")
	local equipRemote = dataRemotes and dataRemotes:FindFirstChild("EquipCosmetic")
	if not equipRemote then
		Notify("Cosmetic changer", "RIVALS EquipCosmetic is unavailable.")
		return
	end
	local skinName = selectedSkin.Name == "Default" and "None" or selectedSkin.Name
	local success, errorMessage = pcall(function()
		equipRemote:FireServer(selectedWeapon.Name, "Skin", skinName, {})
	end)
	if success then
		Notify("Selection applied", selectedWeapon.Name .. " • " .. selectedSkin.Name)
	else
		Notify("Cosmetic changer", tostring(errorMessage))
	end
end

