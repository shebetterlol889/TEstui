        function object:OnChanged(callback)
            self.Changed = callback
            return self
        end

        function object:SetVisible(value)
            self.Visible = value == true
            return self
        end

        function object:SetDisabled(value)
            self.Disabled = value == true
            return self
        end

        function object:AddColorPicker(index, info)
            info = info or {}
            local picker = {
                Type = "ColorPicker",
                Title = info.Title or info.Text or index,
                Value = info.Default or Color3.new(1, 1, 1),
                Transparency = info.Transparency or 0,
                Callback = info.Callback,
                Parent = self,
            }
            AttachCommon(picker)
            function picker:SetValueRGB(color, transparency)
                if typeof(color) == "Color3" then self.Value = color end
                if transparency ~= nil then self.Transparency = transparency end
                SafeCall(self.Callback, self.Value, self.Transparency)
                SafeCall(self.Changed, self.Value, self.Transparency)
            end
            function picker:SetValue(value)
                self:SetValueRGB(value, self.Transparency)
            end
            table.insert(self.Addons, picker)
            Library.Options[index] = picker
            return self
        end

        function object:AddKeyPicker(index, info)
            info = info or {}
            local picker = {
                Type = "KeyPicker",
                Text = info.Text or index,
                Value = tostring(info.Default or "None"),
                DisplayValue = tostring(info.Default or "None"),
                Mode = info.Mode or "Toggle",
                Modifiers = info.DefaultModifiers or {},
                Toggled = info.Mode == "Always",
                SyncToggleState = info.SyncToggleState == true,
                Callback = info.Callback,
                Parent = self,
            }
            AttachCommon(picker)
            function picker:SetValue(value)
                if type(value) == "table" then
                    self.Value = tostring(value[1] or "None")
                    self.Mode = value[2] or self.Mode
                    self.Modifiers = value[3] or self.Modifiers
                else
                    self.Value = tostring(value or "None")
                end
                self.DisplayValue = self.Value
                self.Toggled = self.Mode == "Always"
                SafeCall(self.Changed, self.Value, self.Modifiers)
            end
            function picker:GetState()
                if self.Mode == "Always" then return true end
                if self.Mode == "Hold" then
                    local mouseTypes = {
                        MB1 = Enum.UserInputType.MouseButton1,
                        MB2 = Enum.UserInputType.MouseButton2,
                        MB3 = Enum.UserInputType.MouseButton3,
                    }
                    local mouseType = mouseTypes[self.Value]
                    if mouseType then return InputService:IsMouseButtonPressed(mouseType) end
                    local key = Enum.KeyCode[self.Value]
                    return key and InputService:IsKeyDown(key) or false
                end
                return self.Toggled == true
            end
            function picker:OnClick(callback)
                self.Clicked = callback
                return self
            end
            table.insert(self.Addons, picker)
            table.insert(Library._KeyPickers, picker)
            Library.Options[index] = picker
            return self
        end

        function object:AddDropdown(index, info)
            info = info or {}
            local values = info.Values or {}
            local value = info.Default
            if type(value) == "number" then value = values[value] end
            if value == nil then value = values[1] end
            local dropdown = {
                Type = "Dropdown",
                Text = info.Text or index,
                Values = values,
                Value = value,
                Multi = info.Multi == true,
                Callback = info.Callback,
                Parent = self,
            }
            AttachCommon(dropdown)
            function dropdown:SetValue(newValue)
                self.Value = newValue
                SafeCall(self.Callback, self.Value)
                SafeCall(self.Changed, self.Value)
            end
            function dropdown:SetValues(newValues)
                self.Values = newValues or {}
                if not self.Multi and not table.find(self.Values, self.Value) then
                    self.Value = self.Values[1]
                end
                return self
            end
            table.insert(self.Addons, dropdown)
            Library.Options[index] = dropdown
            return self
        end

        return object
    end

    local function EmitValue(object)
        SafeCall(object.Callback, object.Value)
        SafeCall(object.Changed, object.Value)
    end

    local GroupMethods = {}

    function GroupMethods:AddToggle(index, info)
        info = info or {}
        local toggle = AttachCommon({
