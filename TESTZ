local LegacyTabOrder = {"Player", "World", "Legit", "Rage", "ESP", "Visuals", "Misc", "Feedback", "Config"}
local ElementKeys = {}
for key, object in pairs(LegacyToggles or {}) do ElementKeys[object] = tostring(key) end
for key, object in pairs(LegacyOptions or {}) do ElementKeys[object] = tostring(key) end
local MirroredObjects = {}
local CardCounter = 0

local function Humanize(value)
	local text = tostring(value or "Option")
	text = text:gsub("_", " "):gsub("(%l)(%u)", "%1 %2"):gsub("(%a)(%d)", "%1 %2")
	return text
end

local function DisplayKey(value)
	if typeof(value) == "EnumItem" then return value.Name end
	if type(value) == "table" then value = value[1] or value.Value end
	local text = tostring(value or "None")
	return text ~= "" and text or "None"
end

local function ReadElementText(element)
	local key = ElementKeys[element]
	local text = element.Text or element.OriginalText or key
	if (not text or text == "") and element.TextLabel then text = element.TextLabel.Text end
	return tostring(text or Humanize(key))
end

local function SafeSet(element, value)
	if not element or element.Disabled or type(element.SetValue) ~= "function" then return end
	pcall(element.SetValue, element, value)
end

local function AddLiveControl(card, spec, object, getter, suffix)
	local key = ElementKeys[object] or (card.title .. "." .. tostring(#card.controls + 1))
	spec.id = "backend." .. tostring(key) .. (suffix and ("." .. suffix) or "")
	spec.live = true
	spec.syncGetter = getter
	table.insert(card.controls, spec)
end

local function AddAddon(card, addon)
	if type(addon) ~= "table" or MirroredObjects[addon] then return end
	MirroredObjects[addon] = true
	local name = Humanize(ElementKeys[addon] or addon.Title or addon.Type)
	if addon.Type == "KeyPicker" then
		AddLiveControl(card, {
			kind = "keybind", label = name, default = DisplayKey(addon.DisplayValue or addon.Value),
			menuBind = ElementKeys[addon] == "MenuKeybind",
			callback = function(value)
				addon:SetValue({value, addon.Mode or "Toggle", addon.Modifiers or {}})
			end,
		}, addon, function() return DisplayKey(addon.DisplayValue or addon.Value) end)
	elseif addon.Type == "ColorPicker" then
		AddLiveControl(card, {
			kind = "color", label = name, default = addon.Value or Theme.Accent,
			callback = function(value) addon:SetValueRGB(value, addon.Transparency) end,
		}, addon, function() return addon.Value end)
	elseif addon.Type == "Dropdown" and not addon.Multi then
		local values = addon.Values or {}
		if #values == 0 then values = {tostring(addon.Value or "None")} end
		AddLiveControl(card, {
			kind = "dropdown", label = name, options = values, default = addon.Value or values[1],
			callback = function(value) SafeSet(addon, value) end,
		}, addon, function() return addon.Value end)
	end
end

local function AddElement(card, element)
	if type(element) ~= "table" or MirroredObjects[element] then return end
	MirroredObjects[element] = true
	local key = ElementKeys[element]
	local text = ReadElementText(element)
	local lowered = string.lower(text)
	if key ~= "WeatherType" and text ~= "Menu bind" and text ~= "Unload UI (Delete Cheat)" then
		if element.Type == "Toggle" then
			AddLiveControl(card, {
				kind = "toggle", label = text, default = element.Value == true,
				callback = function(value) if element.Value ~= value then SafeSet(element, value) end end,
			}, element, function() return element.Value == true end)
		elseif element.Type == "Slider" then
			local rounding = tonumber(element.Rounding) or 0
			AddLiveControl(card, {
				kind = "slider", label = text, min = element.Min or 0, max = element.Max or 100,
				default = element.Value or element.Min or 0, suffix = element.Suffix or "",
				step = rounding > 0 and (10 ^ -rounding) or 1,
				callback = function(value) if element.Value ~= value then SafeSet(element, value) end end,
			}, element, function() return element.Value end)
		elseif element.Type == "Dropdown" then
			local values = element.Values or {}
			if element.Multi then
				for _, listed in ipairs(values) do
					local choice = listed
					AddLiveControl(card, {
						kind = "toggle", label = text .. ": " .. tostring(choice),
						default = type(element.Value) == "table" and element.Value[choice] == true,
						callback = function(enabled)
							local updated = {}
							for current, active in pairs(element.Value or {}) do updated[current] = active end
							updated[choice] = enabled or nil
							SafeSet(element, updated)
						end,
					}, element, function()
						return type(element.Value) == "table" and element.Value[choice] == true
					end, tostring(choice))
				end
			else
				if #values == 0 then values = {tostring(element.Value or "None")} end
				AddLiveControl(card, {
					kind = "dropdown", label = text, options = values, default = element.Value or values[1],
					callback = function(value) SafeSet(element, value) end,
				}, element, function() return element.Value end)
			end
		elseif element.Type == "Input" then
			AddLiveControl(card, {
				kind = "input", label = text, placeholder = element.Placeholder or "Enter value",
				default = tostring(element.Value or ""),
				callback = function(value) SafeSet(element, element.Numeric and tonumber(value) or value) end,
			}, element, function() return tostring(element.Value or "") end)
		elseif element.Type == "Label" then
			if text ~= "" then table.insert(card.controls, {kind = "note", label = "Note", text = text, height = 38}) end
		elseif element.Type ~= "Divider" and type(element.Func) == "function" then
			table.insert(card.controls, {
				kind = "button", label = text,
				danger = lowered:find("delete", 1, true) ~= nil or lowered:find("reset", 1, true) ~= nil,
				callback = function() if not element.Disabled then task.spawn(element.Func) end end,
			})
		end
	end
	for _, addon in ipairs(element.Addons or {}) do AddAddon(card, addon) end
end

local function ResolvePage(tabName, groupName)
	if tabName == "Legit" then
		if groupName == "Aimbot" or groupName == "Sniper Mode" or groupName == "Orbit" or groupName == "Stick to Target" then
			return "Camera Aim"
		elseif groupName == "Team Check" or groupName == "Anti Aim" then
			return "Targeting"
		end
		return "Shooting"
	elseif tabName == "Rage" then return "Shooting"
	elseif tabName == "ESP" then return "ESP"
	elseif tabName == "World" or tabName == "Visuals" then
		return groupName == "Chat Win Streak Simulator" and "Feedback" or "World"
	elseif tabName == "Player" then
		if groupName == "Movement" or groupName == "Fly" or groupName == "Misc / Spoofer" then return "World" end
		return "Autoplay"
	elseif tabName == "Misc" then
		if groupName == "Unlock All" then return "Skins" end
		if groupName == "Name Spoofer" or groupName == "Universal Spoofer" or groupName == "Team Debug" then return "Targeting" end
		return "Autoplay"
	elseif tabName == "Feedback" then return "Feedback"
	elseif tabName == "Config" then return "Config" end
	return "Config"
end

