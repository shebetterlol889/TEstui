local function StateId(pageName, cardName, label)
	return (pageName .. "." .. cardName .. "." .. label):gsub("%s+", "_")
end

local function SpecId(card, spec)
	return spec.id or StateId(card.PageName, card.Title, spec.label)
end

local function CopyValue(value)
	if typeof(value) == "Color3" then
		return Color3.new(value.R, value.G, value.B)
	end
	return value
end

local function RegisterControl(id, defaultValue, setter, getter)
	ControlRegistry[id] = {
		Default = CopyValue(defaultValue),
		Set = setter,
		Get = getter,
	}
end

local ActionMap = {
	unload = DestroyInterface,
}

local function Hover(object, normalColor, hoverColor)
	Connect(object.MouseEnter, function()
		Tween(object, {BackgroundColor3 = hoverColor}, 0.1)
	end)
	Connect(object.MouseLeave, function()
		Tween(object, {BackgroundColor3 = normalColor}, 0.1)
	end)
end

local function CreateToggle(parent, id, defaultValue, callback, compact)
	local value = State[id]
	if type(value) ~= "boolean" then
		value = defaultValue == true
		State[id] = value
	end

	local width = compact and 38 or 42
	local height = compact and 20 or 22
	local knobSize = height - 6
	local button = New("TextButton", {
		Name = "Toggle",
		Size = UDim2.fromOffset(width, height),
		BackgroundColor3 = value and Theme.Accent or Theme.ToggleOff,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 12,
		Parent = parent,
	})
	AddCorner(button, height)
	local stroke = AddStroke(button, value and Theme.AccentBright or Theme.Stroke, 0.42, 1)
	local knob = New("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = value and UDim2.new(1, -knobSize - 3, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(knobSize, knobSize),
		BackgroundColor3 = Theme.Text,
		BorderSizePixel = 0,
		ZIndex = 13,
		Parent = button,
	})
	AddCorner(knob, knobSize)

	local function set(nextValue, fireCallback)
		value = nextValue == true
		State[id] = value
		Tween(button, {BackgroundColor3 = value and Theme.Accent or Theme.ToggleOff}, 0.13)
		Tween(stroke, {Color = value and Theme.AccentBright or Theme.Stroke}, 0.13)
		Tween(knob, {
			Position = value and UDim2.new(1, -knobSize - 3, 0.5, 0)
				or UDim2.new(0, 3, 0.5, 0),
		}, 0.13)
		if fireCallback ~= false and callback then
			callback(value)
		end
	end

	Connect(button.Activated, function()
		set(not value, true)
	end)
	RegisterControl(id, defaultValue == true, set, function()
		return value
	end)
	return button, set
end

