	local header = New("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, HeaderHeight),
		BackgroundColor3 = Theme.Window,
		BorderSizePixel = 0,
		ZIndex = 5,
		Parent = root,
	})

	New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Theme.Stroke,
		BorderSizePixel = 0,
		ZIndex = 6,
		Parent = header,
	})

	local tabHolder = New("Frame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(10, 7),
		Size = UDim2.new(1, TouchMode and -64 or -20, 0, 45),
		BackgroundTransparency = 1,
		ZIndex = 6,
		Parent = header,
	})

	New("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = tabHolder,
	})

	local body = New("Frame", {
		Name = "Body",
		Position = UDim2.fromOffset(0, HeaderHeight),
		Size = UDim2.new(1, 0, 1, -HeaderHeight),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 4,
		Parent = root,
	})

	local category = {
		Root = root,
		Header = header,
		Body = body,
		Pages = {},
		Buttons = {},
		ActiveTab = tabNames[1],
	}
	Categories[name] = category

	for index, tabName in ipairs(tabNames) do
		local width = math.max(68, (#tabName * 7) + 28)
		local button = New("TextButton", {
			Name = tabName,
			Size = UDim2.fromOffset(width, 42),
			BackgroundColor3 = index == 1 and Theme.Active or Theme.Window,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Font = Enum.Font.GothamMedium,
			Text = tabName,
			TextColor3 = index == 1 and Theme.Text or Theme.Dim,
			TextSize = 12,
			LayoutOrder = index,
			ZIndex = 7,
			Parent = tabHolder,
		})
		Corner(button, 6)

		local underline = New("Frame", {
			Name = "Underline",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 1),
			Size = UDim2.new(0.62, 0, 0, 2),
			BackgroundColor3 = Theme.Accent,
			BackgroundTransparency = index == 1 and 0 or 1,
			BorderSizePixel = 0,
			ZIndex = 8,
			Parent = button,
		})
		Corner(underline, 1)

		local page = New("ScrollingFrame", {
			Name = tabName .. "Page",
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.new(1, -20, 1, -20),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.fromOffset(0, 0),
			ScrollBarImageColor3 = Theme.Accent,
			ScrollBarImageTransparency = TouchMode and 0.05 or 0.25,
			ScrollBarThickness = TouchMode and 4 or 2,
			ElasticBehavior = TouchMode and Enum.ElasticBehavior.Always or Enum.ElasticBehavior.WhenScrollable,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Visible = index == 1,
			ZIndex = 5,
			Parent = body,
		})
		page:SetAttribute("LeftY", 0)
		page:SetAttribute("RightY", 0)
		page:SetAttribute("MobileY", 0)

		category.Pages[tabName] = page
		category.Buttons[tabName] = {
			Button = button,
			Underline = underline,
		}

		Connect(button.MouseEnter, function()
			if category.ActiveTab ~= tabName then
				Tween(button, {TextColor3 = Theme.Muted})
			end
		end)

		Connect(button.MouseLeave, function()
			if category.ActiveTab ~= tabName then
				Tween(button, {TextColor3 = Theme.Dim})
			end
		end)

		Connect(button.Activated, function()
			category.ActiveTab = tabName
			for pageName, currentPage in pairs(category.Pages) do
				currentPage.Visible = pageName == tabName
				if currentPage.Visible then
					currentPage.CanvasPosition = Vector2.zero
				end
			end
			for buttonName, data in pairs(category.Buttons) do
				local active = buttonName == tabName
				Tween(data.Button, {
					BackgroundColor3 = active and Theme.Active or Theme.Window,
					TextColor3 = active and Theme.Text or Theme.Dim,
				})
				Tween(data.Underline, {
					BackgroundTransparency = active and 0 or 1,
				})
			end
		end)
	end

	return category
end

