do
    local CaptionRunService = game:GetService("RunService")
    local CaptionWorkspace = game:GetService("Workspace")
    local CaptionEnvironment = getgenv()
    local PreviousCaption = CaptionEnvironment.KiraFovCaptionRuntime
    if type(PreviousCaption) == "table" and type(PreviousCaption.Stop) == "function" then
        pcall(PreviousCaption.Stop)
    end

    local CaptionConfig = CaptionEnvironment.KiraFovCaptionConfig
    if type(CaptionConfig) ~= "table" then
        CaptionConfig = {}
        CaptionEnvironment.KiraFovCaptionConfig = CaptionConfig
    end
    if CaptionConfig.Enabled == nil then CaptionConfig.Enabled = false end
    CaptionConfig.Text = tostring(CaptionConfig.Text or "ragebot: idle...")
    CaptionConfig.Offset = math.clamp(tonumber(CaptionConfig.Offset) or 28, 12, 120)
    CaptionConfig.Size = math.clamp(tonumber(CaptionConfig.Size) or 13, 8, 28)
    if typeof(CaptionConfig.Color) ~= "Color3" then
        CaptionConfig.Color = Color3.fromRGB(228, 230, 235)
    end

    local CaptionRuntime = {Stopped = false, Connection = nil, Drawing = nil}
    CaptionEnvironment.KiraFovCaptionRuntime = CaptionRuntime
    local drawingOk, captionDrawing = pcall(function()
        return Drawing.new("Text")
    end)
    if drawingOk and captionDrawing then
        CaptionRuntime.Drawing = captionDrawing
        captionDrawing.Center = true
        captionDrawing.Outline = true
        captionDrawing.OutlineColor = Color3.fromRGB(20, 20, 24)
        captionDrawing.Transparency = 1
        captionDrawing.Visible = false
        CaptionRuntime.Connection = CaptionRunService.RenderStepped:Connect(function()
            if CaptionRuntime.Stopped then return end
            local camera = CaptionWorkspace.CurrentCamera
            local visible = CaptionConfig.Enabled and camera ~= nil and CaptionConfig.Text ~= ""
            captionDrawing.Visible = visible
            if not visible then return end
            local viewport = camera.ViewportSize
            captionDrawing.Text = CaptionConfig.Text
            captionDrawing.Size = CaptionConfig.Size
            captionDrawing.Color = CaptionConfig.Color
            captionDrawing.Position = Vector2.new(viewport.X / 2, (viewport.Y / 2) + CaptionConfig.Offset)
        end)
    end
    function CaptionRuntime.Stop()
        if CaptionRuntime.Stopped then return end
        CaptionRuntime.Stopped = true
        if CaptionRuntime.Connection then CaptionRuntime.Connection:Disconnect() end
        if CaptionRuntime.Drawing then
            pcall(function() CaptionRuntime.Drawing:Remove() end)
        end
        if CaptionEnvironment.KiraFovCaptionRuntime == CaptionRuntime then
            CaptionEnvironment.KiraFovCaptionRuntime = nil
        end
    end

    -- Keep these controls in the real Visual Customization group; the replica
    -- router below places them inside Visuals > Extra > Crosshair - Changer.
    VisualsGroup:AddInput("KiraFovCustomText", {
        Default = CaptionConfig.Text,
        Numeric = false,
        Finished = false,
        AllowEmpty = true,
        Text = "Custom Text",
        Placeholder = "ragebot: idle...",
    })
    Options.KiraFovCustomText:OnChanged(function()
        CaptionConfig.Text = tostring(Options.KiraFovCustomText.Value or "")
    end)
    VisualsGroup:AddToggle("KiraFovShowText", {
        Text = "Show Text",
        Default = CaptionConfig.Enabled,
        Callback = function(value)
            CaptionConfig.Enabled = value
        end,
    })
    VisualsGroup:AddLabel("FOV Text Color"):AddColorPicker("KiraFovTextColor", {
        Default = CaptionConfig.Color,
        Title = "FOV Text Color",
    })
    Options.KiraFovTextColor:OnChanged(function()
        CaptionConfig.Color = Options.KiraFovTextColor.Value
    end)
    VisualsGroup:AddSlider("KiraFovTextSize", {
        Text = "Text Size",
        Default = CaptionConfig.Size,
        Min = 8,
        Max = 28,
        Rounding = 0,
        Suffix = "px",
    })
    Options.KiraFovTextSize:OnChanged(function()
        CaptionConfig.Size = Options.KiraFovTextSize.Value
    end)
    VisualsGroup:AddSlider("KiraFovTextOffset", {
        Text = "Text Offset",
        Default = CaptionConfig.Offset,
        Min = 12,
        Max = 120,
        Rounding = 0,
        Suffix = "px",
    })
    Options.KiraFovTextOffset:OnChanged(function()
        CaptionConfig.Offset = Options.KiraFovTextOffset.Value
    end)

    Library:OnUnload(function()
        CaptionRuntime.Stop()
    end)
end

return Library, Tabs, Options, Toggles
end

