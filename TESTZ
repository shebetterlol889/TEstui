		if control.syncGetter then
			table.insert(BackendSyncEntries, {Id = SpecId(card, control), Get = control.syncGetter, Last = nil})
		end
	end

	ReflowCard(card)
	table.insert(PageCards[pageName], card)
	table.insert(AllCards, card)
	return card
end

