    local Runtime = {
        Connection = nil,
        Container = nil,
        Canopy = nil,
        Emitter = nil,
        Atmosphere = nil,
        Clouds = nil,
        LightingSnapshot = nil,
        Elapsed = 0,
        Stopped = false,
    }
    WeatherEnvironment.KiraWeatherRuntime = Runtime

    local function DestroyVisualObjects()
        if Runtime.Container then Runtime.Container:Destroy() end
        if Runtime.Atmosphere then Runtime.Atmosphere:Destroy() end
        if Runtime.Clouds then Runtime.Clouds:Destroy() end
        Runtime.Container = nil
        Runtime.Canopy = nil
        Runtime.Emitter = nil
        Runtime.Atmosphere = nil
        Runtime.Clouds = nil
    end

    local function CaptureLighting()
        if Runtime.LightingSnapshot then return end
        Runtime.LightingSnapshot = {
            FogColor = WeatherLighting.FogColor,
            FogStart = WeatherLighting.FogStart,
            FogEnd = WeatherLighting.FogEnd,
            ExposureCompensation = WeatherLighting.ExposureCompensation,
            OutdoorAmbient = WeatherLighting.OutdoorAmbient,
        }
    end

    local function RestoreLighting()
        local snapshot = Runtime.LightingSnapshot
        if not snapshot then return end
        for property, value in pairs(snapshot) do
            pcall(function() WeatherLighting[property] = value end)
        end
        Runtime.LightingSnapshot = nil
    end

    local function EnsureVisualObjects()
        if Runtime.Container and Runtime.Container.Parent then return end
        local stale = WeatherWorkspace:FindFirstChild("KiraClientWeather")
        if stale then stale:Destroy() end
        local oldPart = WeatherWorkspace:FindFirstChild("Kira.WinWeatherPart")
        if oldPart then oldPart:Destroy() end

        Runtime.Container = Instance.new("Folder")
        Runtime.Container.Name = "KiraClientWeather"
        Runtime.Container.Parent = WeatherWorkspace

        Runtime.Canopy = Instance.new("Part")
        Runtime.Canopy.Name = "WeatherCanopy"
        Runtime.Canopy.Anchored = true
        Runtime.Canopy.CanCollide = false
        Runtime.Canopy.CanQuery = false
        Runtime.CanTouch = false
        Runtime.Canopy.CastShadow = false
        Runtime.Canopy.Transparency = 1
        Runtime.Canopy.Parent = Runtime.Container

        Runtime.Emitter = Instance.new("ParticleEmitter")
        Runtime.Emitter.Name = "WeatherParticles"
        Runtime.Emitter.EmissionDirection = Enum.NormalId.Bottom
        Runtime.Emitter.LockedToPart = false
        Runtime.Emitter.VelocityInheritance = 0
        Runtime.Emitter.LightInfluence = 0.45
        Runtime.Emitter.ZOffset = 0.1
        Runtime.Emitter.Parent = Runtime.Canopy
        pcall(function()
            Runtime.Emitter.Shape = Enum.ParticleEmitterShape.Box
            Runtime.Emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
        end)

        Runtime.Atmosphere = Instance.new("Atmosphere")
        Runtime.Atmosphere.Name = "KiraWeatherAtmosphere"
        Runtime.Atmosphere.Parent = WeatherLighting

        pcall(function()
            Runtime.Clouds = Instance.new("Clouds")
            Runtime.Clouds.Name = "KiraWeatherClouds"
            Runtime.Clouds.Parent = WeatherWorkspace.Terrain
        end)
    end

    local function ApplyWeather()
        if Runtime.Stopped then return end
        local preset = WeatherPresets[WeatherConfig.Type]
        if not WeatherConfig.Enabled or WeatherConfig.Type == "Clear" or not preset then
            DestroyVisualObjects()
            RestoreLighting()
            return
        end

        CaptureLighting()
        EnsureVisualObjects()
        if not Runtime.Emitter or not Runtime.Canopy then return end

        local radius = WeatherConfig.Radius
        local sizeScale = WeatherConfig.ParticleSize / 100
        local opaque = 1 - (WeatherConfig.ParticleOpacity / 100)
        local areaScale = math.clamp((radius / 140) ^ 1.2, 0.45, 2.75)
        Runtime.Canopy.Size = Vector3.new(radius * 2, 1, radius * 2)
        local camera = WeatherWorkspace.CurrentCamera
        if camera then
            local height = (WeatherConfig.Type == "Fog" or WeatherConfig.Type == "Sandstorm") and 12 or 62
            Runtime.Canopy.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, height, 0))
        end

        local emitter = Runtime.Emitter
        emitter.Enabled = true
        emitter.Texture = preset.Texture
        local rateLimit = Library.IsMobile and 700 or 1200
        emitter.Rate = math.floor(math.clamp(
            preset.Rate * (WeatherConfig.Density / 65) * areaScale,
            8,
            rateLimit
        ))
        emitter.Lifetime = NumberRange.new(
            math.max(0.35, WeatherConfig.ParticleLifetime * 0.72),
            math.max(0.5, WeatherConfig.ParticleLifetime * 1.16)
        )
        emitter.Speed = preset.Speed
        emitter.Acceleration = preset.Acceleration
        emitter.SpreadAngle = preset.Spread
        emitter.Rotation = NumberRange.new(-180, 180)
        emitter.RotSpeed = NumberRange.new(-32, 32)
        emitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, preset.Size * sizeScale * 0.75),
            NumberSequenceKeypoint.new(0.2, preset.Size * sizeScale),
            NumberSequenceKeypoint.new(1, preset.Size * sizeScale * 0.82),
        })
        emitter.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.08, opaque),
            NumberSequenceKeypoint.new(0.9, math.min(1, opaque + 0.1)),
            NumberSequenceKeypoint.new(1, 1),
        })
        emitter.Color = preset.Color
        pcall(function() emitter.Squash = NumberSequence.new(preset.Squash or 0) end)

        local atmosphere = Runtime.Atmosphere
        if atmosphere then
            atmosphere.Color = preset.Atmosphere.Color
            atmosphere.Decay = preset.Atmosphere.Decay
            atmosphere.Density = preset.Atmosphere.Density
            atmosphere.Glare = 0
            atmosphere.Haze = preset.Atmosphere.Haze
            atmosphere.Offset = 0
        end
        local clouds = Runtime.Clouds
        if clouds then
            clouds.Enabled = true
            clouds.Color = preset.Clouds.Color
            clouds.Cover = preset.Clouds.Cover
            clouds.Density = preset.Clouds.Density
        end
        for property, value in pairs(preset.Lighting) do
            pcall(function() WeatherLighting[property] = value end)
        end
    end

    Runtime.Apply = ApplyWeather
    Runtime.Connection = WeatherRunService.Heartbeat:Connect(function(deltaTime)
        if Runtime.Stopped or not WeatherConfig.Enabled or WeatherConfig.Type == "Clear" then return end
        Runtime.Elapsed += deltaTime
        if Runtime.Elapsed < 0.1 then return end
        Runtime.Elapsed = 0
        local camera = WeatherWorkspace.CurrentCamera
        if camera and Runtime.Canopy and Runtime.Canopy.Parent then
            local height = (WeatherConfig.Type == "Fog" or WeatherConfig.Type == "Sandstorm") and 12 or 62
            Runtime.Canopy.CFrame = CFrame.new(camera.CFrame.Position + Vector3.new(0, height, 0))
        end
    end)
    function Runtime.Stop()
        if Runtime.Stopped then return end
        Runtime.Stopped = true
        if Runtime.Connection then Runtime.Connection:Disconnect() end
        DestroyVisualObjects()
        RestoreLighting()
        if WeatherEnvironment.KiraWeatherRuntime == Runtime then
            WeatherEnvironment.KiraWeatherRuntime = nil
        end
    end

    if VisualSettings then
        VisualSettings.WeatherType = "None"
    end
    if ZX_Visuals then
        ZX_Visuals.applyWeather = function()
            VisualSettings.WeatherType = "None"
            local oldPart = WeatherWorkspace:FindFirstChild("Kira.WinWeatherPart")
            if oldPart then oldPart:Destroy() end
        end
    end

    local WeatherGroup = Tabs.World:AddRightGroupbox("Weather & Sky")
    WeatherGroup:AddToggle("KiraPresetWeather", {
        Text = "Preset Weather",
        Default = WeatherConfig.Enabled,
        Tooltip = "Client-side weather and atmosphere preset.",
        Callback = function(value)
            WeatherConfig.Enabled = value
            ApplyWeather()
        end,
    })
    WeatherGroup:AddDropdown("KiraWeatherType", {
        Values = WeatherTypes,
        Default = table.find(WeatherTypes, WeatherConfig.Type) or 4,
        Multi = false,
        Text = "Weather Type",
    })
    Options.KiraWeatherType:OnChanged(function()
        WeatherConfig.Type = Options.KiraWeatherType.Value or "Snow"
        ApplyWeather()
    end)
    WeatherGroup:AddSlider("KiraWeatherDensity", {
        Text = "Weather Density",
        Default = WeatherConfig.Density,
        Min = 1,
        Max = 100,
        Rounding = 0,
        Suffix = "%",
    })
    Options.KiraWeatherDensity:OnChanged(function()
        WeatherConfig.Density = Options.KiraWeatherDensity.Value
        ApplyWeather()
    end)
    WeatherGroup:AddSlider("KiraWeatherParticleSize", {
        Text = "Particle Size",
        Default = WeatherConfig.ParticleSize,
        Min = 20,
        Max = 250,
        Rounding = 0,
        Suffix = "%",
    })
    Options.KiraWeatherParticleSize:OnChanged(function()
        WeatherConfig.ParticleSize = Options.KiraWeatherParticleSize.Value
        ApplyWeather()
    end)
    WeatherGroup:AddSlider("KiraWeatherParticleLifetime", {
        Text = "Particle Lifetime",
        Default = WeatherConfig.ParticleLifetime,
        Min = 1,
        Max = 15,
        Rounding = 1,
        Suffix = "s",
    })
    Options.KiraWeatherParticleLifetime:OnChanged(function()
        WeatherConfig.ParticleLifetime = Options.KiraWeatherParticleLifetime.Value
        ApplyWeather()
    end)
    WeatherGroup:AddSlider("KiraWeatherParticleOpacity", {
        Text = "Particle Opacity",
        Default = WeatherConfig.ParticleOpacity,
        Min = 10,
        Max = 100,
        Rounding = 0,
        Suffix = "%",
    })
    Options.KiraWeatherParticleOpacity:OnChanged(function()
        WeatherConfig.ParticleOpacity = Options.KiraWeatherParticleOpacity.Value
        ApplyWeather()
    end)
    WeatherGroup:AddSlider("KiraWeatherRadius", {
        Text = "Weather Radius",
        Default = WeatherConfig.Radius,
        Min = 40,
        Max = 300,
        Rounding = 0,
        Suffix = " studs",
    })
    Options.KiraWeatherRadius:OnChanged(function()
        WeatherConfig.Radius = Options.KiraWeatherRadius.Value
        ApplyWeather()
    end)

    Library:OnUnload(function()
        Runtime.Stop()
    end)
end

