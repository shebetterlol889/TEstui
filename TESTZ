local function LoadCosmeticCatalogue()
	if CosmeticBrowser.Loaded then
		return true
	end
	if CosmeticBrowser.Loading then
		repeat task.wait() until not CosmeticBrowser.Loading
		return CosmeticBrowser.Loaded
	end
	CosmeticBrowser.Loading = true
	local success, result = xpcall(function()
		local replicatedStorage = game:GetService("ReplicatedStorage")
		local modules = replicatedStorage:FindFirstChild("Modules")
		if not modules then
			error("RIVALS Modules folder is not available yet")
		end
		local cosmeticModule = modules:FindFirstChild("CosmeticLibrary")
		local itemModule = modules:FindFirstChild("ItemLibrary")
		if not cosmeticModule or not itemModule then
			error("RIVALS item or cosmetic library is unavailable")
		end
		local cosmeticLibrary = require(cosmeticModule)
		local itemLibrary = require(itemModule)
		local cosmetics = cosmeticLibrary and cosmeticLibrary.Cosmetics
		local items = itemLibrary and itemLibrary.Items
		if type(cosmetics) ~= "table" or type(items) ~= "table" then
			error("RIVALS returned an unsupported cosmetic catalogue")
		end

		local renderedIcons = BuildRenderedIconIndex()
		local weapons = {}
		local comparisons = 0
		for weaponName, weaponData in pairs(items) do
			if type(weaponName) == "string" and type(weaponData) == "table" then
				local skins = {}
				for skinName, skinData in pairs(cosmetics) do
					if type(skinName) == "string" and type(skinData) == "table"
						and skinData.Type == "Skin"
						and MetadataLinksSkinToWeapon(skinName, skinData, weaponName, weaponData) then
						table.insert(skins, {
							Name = skinName,
							Icon = FindImageInData(skinData, 0),
						})
					end
					comparisons = comparisons + 1
					if comparisons % 300 == 0 then
						task.wait()
					end
				end
				if #skins > 0 then
					table.sort(skins, function(a, b) return a.Name < b.Name end)
					table.insert(weapons, {
						Name = weaponName,
						Data = weaponData,
						Icon = FindImageInData(weaponData, 0)
							or renderedIcons[string.lower(weaponName)],
						Skins = skins,
					})
				end
			end
		end
		table.sort(weapons, function(a, b) return a.Name < b.Name end)
		CosmeticBrowser.Weapons = weapons
		CosmeticBrowser.Loaded = true
		return #weapons
	end, function(message)
		if debug and type(debug.traceback) == "function" then
			return debug.traceback(tostring(message), 2)
		end
		return tostring(message)
	end)
	CosmeticBrowser.Loading = false
	if not success then
		warn("[Kira.Win] cosmetic catalogue: " .. tostring(result))
		Notify("Cosmetic changer", tostring(result))
		return false
	end
	return true
end

