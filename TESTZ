local function ReadExecutorName()
	local detectors = {}
	if type(identifyexecutor) == "function" then
		table.insert(detectors, identifyexecutor)
	end
	if type(getexecutorname) == "function" then
		table.insert(detectors, getexecutorname)
	end
	for _, detector in ipairs(detectors) do
		if type(detector) == "function" then
			local success, name = pcall(detector)
			if success and type(name) == "string" and name ~= "" then
				return name
			end
		end
	end
	return ""
end

