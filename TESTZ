	card.ChevronUp = chevronUp
	card.ChevronDown = chevronDown
	Connect(chevron.Activated, function()
		card.Collapsed = not card.Collapsed
		ReflowCard(card)
		ReflowPage(pageName)
	end)

	if spec.master ~= false then
		local keyPill = New("TextButton", {
			Name = "MasterKey",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -59, 0.5, 0),
			Size = UDim2.fromOffset(48, 23),
			BackgroundColor3 = Theme.Control,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Font = Enum.Font.GothamMedium,
			Text = spec.key or "None",
			TextColor3 = Theme.Muted,
			TextSize = 8,
			ZIndex = 10,
			Parent = header,
		})
		AddCorner(keyPill, 5)
		AddStroke(keyPill, Theme.Stroke, 0.34, 1)
		Hover(keyPill, Theme.Control, Theme.ControlHover)
		Connect(keyPill.Activated, function()
			keyPill.Text = keyPill.Text == "None" and "MB2" or "None"
		end)

		local masterId = StateId(pageName, spec.title, "Master")
