	function group:Finish()
		UpdateHeight()
		local finalHeight = self.Cursor + 7
		page:SetAttribute(attribute, self.StartY + finalHeight + 10)
		local canvasHeight = math.max(
			MobilePortrait and (page:GetAttribute("MobileY") or 0) or (page:GetAttribute("LeftY") or 0),
			MobilePortrait and 0 or (page:GetAttribute("RightY") or 0),
			page.AbsoluteSize.Y
		)
		page.CanvasSize = UDim2.fromOffset(0, canvasHeight)
		return self
	end

	return group
end

