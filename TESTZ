-- Lightweight Lucide-style vector renderer. Icons are composed from ordinary
-- Roblox Frames/UIStrokes, so the interface stays standalone and uses no assets.
local function VectorIcon(parent, iconName, color, size, zIndex)
	size = size or 18
	color = color or Theme.Text
	zIndex = zIndex or 10

	local canvas = New("Frame", {
		Name = "Icon_" .. tostring(iconName),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = zIndex,
		Parent = parent,
	})

	local scale = size / 24
	local painted = {}

	local function track(object, property)
		table.insert(painted, {
			Object = object,
			Property = property,
		})
		return object
	end

	local function line(x1, y1, x2, y2, width)
		local startX = x1 * scale
		local startY = y1 * scale
		local endX = x2 * scale
		local endY = y2 * scale
		local dx = endX - startX
		local dy = endY - startY
		local length = math.sqrt(dx * dx + dy * dy)
		local segment = track(New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((startX + endX) / 2, (startY + endY) / 2),
			Size = UDim2.fromOffset(length, math.max(1, (width or 1.8) * scale)),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Rotation = math.deg(math.atan2(dy, dx)),
			ZIndex = zIndex + 1,
			Parent = canvas,
		}), "BackgroundColor3")
		AddCorner(segment, 2)
		return segment
	end

	local function polyline(points, closed, width)
		for index = 1, #points - 1 do
			line(points[index][1], points[index][2], points[index + 1][1], points[index + 1][2], width)
		end
		if closed and #points > 2 then
			line(points[#points][1], points[#points][2], points[1][1], points[1][2], width)
		end
	end

	local function circle(centerX, centerY, radius, width)
		local ring = New("Frame", {
			Position = UDim2.fromOffset((centerX - radius) * scale, (centerY - radius) * scale),
			Size = UDim2.fromOffset(radius * 2 * scale, radius * 2 * scale),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = zIndex + 1,
			Parent = canvas,
		})
		AddCorner(ring, radius * 2 * scale)
		local stroke = track(AddStroke(ring, color, 0, math.max(1, (width or 1.8) * scale)), "Color")
		return ring, stroke
	end

	local function rect(x, y, width, height, radius, strokeWidth)
		local box = New("Frame", {
			Position = UDim2.fromOffset(x * scale, y * scale),
			Size = UDim2.fromOffset(width * scale, height * scale),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = zIndex + 1,
			Parent = canvas,
		})
		AddCorner(box, (radius or 2) * scale)
		local stroke = track(
			AddStroke(box, color, 0, math.max(1, (strokeWidth or 1.8) * scale)),
			"Color"
		)
		return box, stroke
	end

	local function dot(centerX, centerY, radius)
		local point = track(New("Frame", {
			Position = UDim2.fromOffset((centerX - radius) * scale, (centerY - radius) * scale),
			Size = UDim2.fromOffset(radius * 2 * scale, radius * 2 * scale),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = zIndex + 2,
			Parent = canvas,
		}), "BackgroundColor3")
		AddCorner(point, radius * 2 * scale)
		return point
	end

	local function diamond(centerX, centerY, radius)
		polyline({
			{centerX, centerY - radius},
			{centerX + radius, centerY},
			{centerX, centerY + radius},
			{centerX - radius, centerY},
		}, true)
	end

