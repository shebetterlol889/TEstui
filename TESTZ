	function group:AddButton(text, callback, dangerous)
		local normal = dangerous and Color3.fromRGB(47, 22, 27) or Theme.PanelRaised
		local hover = dangerous and Color3.fromRGB(63, 27, 34) or Theme.Active
		local buttonHeight = TouchMode and 36 or 28
		local rowHeight = TouchMode and 45 or 37
		local button = New("TextButton", {
			Position = UDim2.fromOffset(10, self.Cursor + 3),
			Size = UDim2.new(1, -20, 0, buttonHeight),
