local function DestroyInterface()
	if not Alive then
		return
	end
	Alive = false
	CloseActiveDropdown()
	if CameraConnection then
		CameraConnection:Disconnect()
		CameraConnection = nil
	end
	for _, connection in ipairs(Connections) do
		if connection.Connected then
			connection:Disconnect()
		end
	end
	table.clear(Connections)
	if LegacyLibrary and type(LegacyLibrary.Unload) == "function" and not LegacyLibrary.Unloaded then
		pcall(function() LegacyLibrary:Unload() end)
	end
	if ScreenGui.Parent then
		ScreenGui:Destroy()
	end
	if RuntimeEnvironment[CleanupKey] == DestroyInterface then
		RuntimeEnvironment[CleanupKey] = nil
	end
end

