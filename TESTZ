-- The cosmetic catalogue is deliberately lazy. It reads the current game's own
-- ItemLibrary/CosmeticLibrary only after this panel is opened, keeping startup fast
-- and keeping weapon imagery current when RIVALS adds or changes weapons.
local CosmeticBrowser = {
	Root = nil,
	Scale = nil,
	Loaded = false,
	Loading = false,
	Weapons = {},
	SelectedWeapon = nil,
	SelectedSkin = nil,
	WeaponFilter = "",
	SkinFilter = "",
}

local function RuntimeValue()
	local environment = RuntimeEnvironment
	if type(environment) ~= "table" then
		environment = _G
	end
	return environment
end

local function NormalizeAsset(value)
	if value == nil then
		return nil
	end
	local valueType = typeof(value)
	if valueType == "number" then
		return "rbxassetid://" .. tostring(math.floor(value))
	end
	local text = tostring(value)
	if text == "" then
		return nil
	end
	if text:match("^%d+$") then
		return "rbxassetid://" .. text
	end
	local embeddedAsset = text:match("(rbxassetid://%d+)")
		or text:match("(rbxthumb://[^%s%'%\"]+)")
	if embeddedAsset then
		return embeddedAsset
	end
	if text:find("rbxassetid://", 1, true)
		or text:find("rbxthumb://", 1, true)
		or text:find("http://", 1, true)
		or text:find("https://", 1, true) then
		return text
	end
	return nil
end

local ImageKeys = {
	icon = true,
	iconid = true,
	image = true,
	imageid = true,
	thumbnail = true,
	thumbnailid = true,
	displayicon = true,
	uiicon = true,
	imagehighresolution = true,
	imagelowresolution = true,
}

local function FindImageInData(value, depth, seen)
	if type(value) ~= "table" or depth > 4 then
		return nil
	end
	seen = seen or {}
	if seen[value] then
		return nil
	end
	seen[value] = true
	for key, child in pairs(value) do
		local normalizedKey = string.lower(tostring(key)):gsub("[^%w]", "")
		if ImageKeys[normalizedKey] or normalizedKey:find("icon", 1, true)
			or normalizedKey:find("image", 1, true)
			or normalizedKey:find("thumbnail", 1, true) then
			local asset = NormalizeAsset(child)
			if asset then
				return asset
			end
		end
	end
	for _, child in pairs(value) do
		if type(child) == "table" then
			local asset = FindImageInData(child, depth + 1, seen)
			if asset then
				return asset
			end
		end
	end
	return nil
end

local RelationKeys = {
	weapon = true,
	weapons = true,
	weaponname = true,
	weaponnames = true,
	baseweapon = true,
	forweapon = true,
	compatibleweapon = true,
	compatibleweapons = true,
	item = true,
	items = true,
	itemname = true,
	itemnames = true,
	foritem = true,
	appliesto = true,
	applicableitems = true,
	parentitem = true,
}

local function SameName(first, second)
	return string.lower(tostring(first)):gsub("[^%w]", "")
		== string.lower(tostring(second)):gsub("[^%w]", "")
end

local function DeepContainsName(value, target, depth, seen)
	if depth > 5 then
		return false
	end
	if type(value) ~= "table" then
		return SameName(value, target)
	end
	seen = seen or {}
	if seen[value] then
		return false
	end
	seen[value] = true
	for key, child in pairs(value) do
		if SameName(key, target) or DeepContainsName(child, target, depth + 1, seen) then
			return true
		end
	end
	return false
end

local function MetadataLinksSkinToWeapon(skinName, skinData, weaponName, weaponData)
	if skinData.Universal == true or skinData.IsUniversal == true then
		return true
	end
	for key, value in pairs(skinData) do
		local normalizedKey = string.lower(tostring(key)):gsub("[^%w]", "")
		if RelationKeys[normalizedKey]
			or normalizedKey:find("weapon", 1, true)
			or normalizedKey:find("applicable", 1, true) then
			if DeepContainsName(value, weaponName, 0) then
				return true
			end
		end
	end
	if type(weaponData) == "table" then
		for key, value in pairs(weaponData) do
			local normalizedKey = string.lower(tostring(key)):gsub("[^%w]", "")
			if normalizedKey:find("skin", 1, true) or normalizedKey:find("cosmetic", 1, true) then
				if DeepContainsName(value, skinName, 0) then
					return true
				end
			end
		end
	end
	return false
end

local function BuildRenderedIconIndex()
	local index = {}
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return index
	end
	for _, object in ipairs(playerGui:GetDescendants()) do
		if (object:IsA("TextLabel") or object:IsA("TextButton")) and object.Text ~= "" then
			local key = string.lower(object.Text:gsub("<.->", "")):gsub("^%s+", ""):gsub("%s+$", "")
			local ancestor = object.Parent
			for _ = 1, 4 do
				if not ancestor then break end
				for _, candidate in ipairs(ancestor:GetDescendants()) do
					if (candidate:IsA("ImageLabel") or candidate:IsA("ImageButton"))
						and candidate.Image ~= "" and candidate.ImageTransparency < 1 then
						index[key] = index[key] or candidate.Image
						break
					end
				end
				if index[key] then break end
				ancestor = ancestor.Parent
			end
		end
	end
	return index
end

local function IsUnlockAllReady()
	local environment = RuntimeValue()
	return type(environment.CosmeticUnlocker) == "table"
