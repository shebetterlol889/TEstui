local function CreateCategory(name, tabNames)
	local root = New("Frame", {
		Name = name .. "Category",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 4,
		Parent = Content,
