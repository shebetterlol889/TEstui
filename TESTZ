		Size = UDim2.fromOffset(24, 24),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 11,
		Parent = header,
	})
	card.Chevron = chevron
	local chevronUp = VectorIcon(chevron, "chevron-up", Theme.Muted, 11, 12)
	local chevronDown = VectorIcon(chevron, "chevron-down", Theme.Muted, 11, 12)
