CooldownState.Enabled = false

local CooldownFields = {"ShootCooldown", "BurstCooldown", "AttackCooldown", "HeavyAttackCooldown"}
local function ScanCooldownTables(root, enabled)
    local visited = {}
    local function scan(tbl)
        if visited[tbl] then return end
        visited[tbl] = true
        for _, value in tbl do
            if typeof(value) == "table" then
                local originals = CooldownState.Originals[value]
                if not originals then
                    originals = {}
                    CooldownState.Originals[value] = originals
                end
                for _, field in ipairs(CooldownFields) do
                    if value[field] ~= nil then
                        if originals[field] == nil then originals[field] = value[field] end
                        value[field] = enabled and 1e-18 or originals[field]
                    end
                end
                scan(value)
            end
        end
    end
    scan(root)
end

local function ApplyAttachedCooldowns(enabled)
    CooldownState.Enabled = enabled
    task.spawn(function()
        local ok, itemLibrary = pcall(function()
            local storage = game:GetService("ReplicatedStorage")
            local modules = storage:WaitForChild("Modules", 10)
            local module = modules and modules:WaitForChild("ItemLibrary", 10)
            if not module then error("ItemLibrary was not found") end
            return require(module)
        end)
        if not ok or type(itemLibrary) ~= "table" then
            CooldownState.Enabled = false
            warn("[Kira.Win] attached cooldown modifier failed: " .. tostring(itemLibrary))
            task.defer(function()
                if Toggles.KiraInstantCooldown and Toggles.KiraInstantCooldown.Value then
                    Toggles.KiraInstantCooldown:SetValue(false)
                end
                Library:Notify("Instant Cooldowns could not find ItemLibrary.", 5)
            end)
            return
        end
        ScanCooldownTables(itemLibrary, enabled)
    end)
end

