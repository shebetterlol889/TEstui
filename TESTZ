local function ApplyResponsiveLayout()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local usePortrait = DeltaMode and viewport.X < 760
	PortraitLayout = usePortrait
	local baseWidth = usePortrait and 600 or 820
	local baseHeight = usePortrait and 650 or 470
	local margin = usePortrait and 12 or 24
	local fitScale = math.min(
		1,
		math.max(0.35, (viewport.X - margin * 2) / baseWidth),
		math.max(0.35, (viewport.Y - margin * 2) / baseHeight)
	)

	Main.Size = UDim2.fromOffset(baseWidth, baseHeight)
	MainScale.Scale = fitScale
	Shadow.Size = UDim2.fromOffset(baseWidth * fitScale + 54, baseHeight * fitScale + 54)
	SearchShell.Visible = not usePortrait
	if usePortrait then
		Brand.Size = UDim2.fromOffset(230, 58)
		HeaderActions.Size = UDim2.fromOffset(220, 58)
	else
		Brand.Size = UDim2.fromOffset(280, 58)
	end
	FooterStatus.Text = DeltaMode and ("DELTA MOBILE READY  •  " .. string.upper(CurrentMenuKey.Name))
		or ("DESKTOP  •  " .. string.upper(CurrentMenuKey.Name))
	CloseActiveDropdown()
	ReflowAllPages()
end

