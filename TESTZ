        function toggle:SetValue(value)
            if self.Disabled then return end
            self.Value = value == true
            EmitValue(self)
        end
        table.insert(self.Elements, toggle)
        Library.Toggles[index] = toggle
        return toggle
    end

    function GroupMethods:AddSlider(index, info)
        info = info or {}
        local slider = AttachCommon({
            Type = "Slider",
            Text = info.Text or index,
            OriginalText = info.Text or index,
            Value = tonumber(info.Default) or 0,
            Min = tonumber(info.Min) or 0,
            Max = tonumber(info.Max) or 100,
            Rounding = tonumber(info.Rounding) or 0,
            Suffix = info.Suffix or "",
            Callback = info.Callback,
        })
        local function Round(value)
            local power = 10 ^ slider.Rounding
            return math.floor(value * power + 0.5) / power
        end
        function slider:SetValue(value)
            if self.Disabled then return end
            self.Value = math.clamp(Round(tonumber(value) or self.Value), self.Min, self.Max)
            EmitValue(self)
        end
        function slider:SetMax(value)
            self.Max = tonumber(value) or self.Max
            self.Value = math.clamp(self.Value, self.Min, self.Max)
        end
        function slider:SetMin(value)
            self.Min = tonumber(value) or self.Min
