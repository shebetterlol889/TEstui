local ToastOrder = 0
local function Notify(title, message)
	if not Alive then
		return
	end
	ToastOrder += 1
	local toast = New("CanvasGroup", {
		Size = UDim2.fromOffset(245, 58),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		LayoutOrder = ToastOrder,
		ZIndex = 101,
		Parent = ToastHolder,
	})
	Corner(toast, 6)
	Stroke(toast, Theme.StrokeLight, 0.1)
	New("Frame", {
		Position = UDim2.fromOffset(8, 11),
		Size = UDim2.fromOffset(2, 36),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 102,
		Parent = toast,
	})
	Label(toast, {
		Position = UDim2.fromOffset(19, 8),
		Size = UDim2.new(1, -28, 0, 18),
		Font = Enum.Font.GothamMedium,
		Text = title,
		TextSize = 10,
		ZIndex = 102,
	})
	Label(toast, {
		Position = UDim2.fromOffset(19, 27),
		Size = UDim2.new(1, -28, 0, 22),
		Text = message,
		TextColor3 = Theme.Muted,
		TextSize = 9,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 102,
	})
	Tween(toast, {GroupTransparency = 0}, 0.16)
	task.delay(3, function()
		if Alive and toast.Parent then
			local out = Tween(toast, {GroupTransparency = 1}, 0.15)
			out.Completed:Wait()
			if toast.Parent then
				toast:Destroy()
			end
		end
	end)
end

