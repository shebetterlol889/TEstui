local function ReflowCard(card)
	if card.Collapsed then
		for _, row in ipairs(card.Rows) do
			row.Root.Visible = false
		end
		card.Height = 50
		card.Root.Size = UDim2.new(card.Root.Size.X.Scale, card.Root.Size.X.Offset, 0, card.Height)
		card.ChevronUp.Visible = false
		card.ChevronDown.Visible = true
		return
	end

	local cursor = 50
	for _, row in ipairs(card.Rows) do
		row.Root.Visible = true
		row.Root.Position = UDim2.fromOffset(0, cursor)
		cursor = cursor + row.Height
	end
	card.Height = cursor + 6
	card.Root.Size = UDim2.new(card.Root.Size.X.Scale, card.Root.Size.X.Offset, 0, card.Height)
	card.ChevronUp.Visible = true
	card.ChevronDown.Visible = false
end

local function ReflowPage(pageName)
	local page = Pages[pageName]
	if not page then
		return
	end

	local leftY = 12
	local rightY = 12
	local mobileY = 12
	for _, card in ipairs(PageCards[pageName]) do
		if card.Root.Visible then
			if PortraitLayout then
				card.Root.Position = UDim2.fromOffset(12, mobileY)
				card.Root.Size = UDim2.new(1, -24, 0, card.Height)
				mobileY = mobileY + card.Height + 10
			elseif card.Column == 1 then
				card.Root.Position = UDim2.fromOffset(12, leftY)
				card.Root.Size = UDim2.new(0.5, -18, 0, card.Height)
				leftY = leftY + card.Height + 10
			else
				card.Root.Position = UDim2.new(0.5, 6, 0, rightY)
				card.Root.Size = UDim2.new(0.5, -18, 0, card.Height)
				rightY = rightY + card.Height + 10
			end
		end
	end

	local contentHeight = PortraitLayout and mobileY or math.max(leftY, rightY)
	page.CanvasSize = UDim2.fromOffset(0, math.max(0, contentHeight + 2))
end

local function ReflowAllPages()
	for pageName in pairs(Pages) do
		ReflowPage(pageName)
	end
end

