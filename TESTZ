			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 9,
			Parent = row,
		})

		local function Set(newValue, fire)
			value = newValue == true
			Tween(toggle, {BackgroundColor3 = value and Theme.Accent or Theme.ToggleOff})
			Tween(knob, {
				Position = value and UDim2.new(1, -(knobSize + knobInset), 0.5, 0)
					or UDim2.new(0, knobInset, 0.5, 0),
				BackgroundColor3 = value and Color3.fromRGB(239, 247, 250) or Theme.Muted,
			})
			if fire ~= false and callback then
				task.spawn(callback, value)
			end
		end

		Connect(toggle.Activated, function()
			Set(not value, true)
		end)
		Connect(labelHitbox.Activated, function()
			Set(not value, true)
		end)

		self.Cursor += rowHeight
		UpdateHeight()
		return {Get = function() return value end, Set = Set}
	end

	function group:AddSlider(text, minimum, maximum, defaultValue, suffix, callback)
		local value = math.clamp(defaultValue, minimum, maximum)
		local dragging = false
		local activeInput
		local rowHeight = TouchMode and 56 or 48
		local trackY = TouchMode and 36 or 30
		local trackHeight = TouchMode and 4 or 3
		local thumbSize = TouchMode and 14 or 11
		local row = New("Frame", {
			Position = UDim2.fromOffset(0, self.Cursor),
			Size = UDim2.new(1, 0, 0, rowHeight),
			BackgroundTransparency = 1,
			ZIndex = 7,
			Parent = frame,
		})

		Label(row, {
			Position = UDim2.fromOffset(11, 2),
			Size = UDim2.new(1, -67, 0, 19),
			Text = text,
			TextSize = TouchMode and 12 or 11,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 8,
		})

		local valueLabel = Label(row, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -11, 0, 2),
			Size = UDim2.fromOffset(57, 19),
			Font = Enum.Font.GothamMedium,
			Text = tostring(value) .. (suffix or ""),
			TextColor3 = Theme.Dim,
			TextSize = 10,
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 8,
		})

		local track = New("Frame", {
			Position = UDim2.fromOffset(11, trackY),
			Size = UDim2.new(1, -22, 0, trackHeight),
			BackgroundColor3 = Color3.fromRGB(37, 37, 42),
			BorderSizePixel = 0,
			ZIndex = 8,
			Parent = row,
		})
		Corner(track, 2)

		local alpha = (value - minimum) / (maximum - minimum)
		local fill = New("Frame", {
			Size = UDim2.fromScale(alpha, 1),
			BackgroundColor3 = Theme.Accent,
			BorderSizePixel = 0,
			ZIndex = 9,
			Parent = track,
		})
		Corner(fill, 2)

		local thumb = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(alpha, 0.5),
			Size = UDim2.fromOffset(thumbSize, thumbSize),
			BackgroundColor3 = Theme.Knob,
			BorderSizePixel = 0,
			ZIndex = 10,
			Parent = track,
		})
		Corner(thumb, 6)

		local hitbox = New("TextButton", {
			Position = UDim2.fromOffset(0, TouchMode and -14 or -8),
			Size = UDim2.new(1, 0, 1, TouchMode and 28 or 16),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 11,
			Parent = track,
		})

		local function Set(newValue, fire)
			value = math.clamp(math.floor(newValue + 0.5), minimum, maximum)
			local amount = (value - minimum) / (maximum - minimum)
			valueLabel.Text = tostring(value) .. (suffix or "")
			Tween(fill, {Size = UDim2.fromScale(amount, 1)}, 0.07)
			Tween(thumb, {Position = UDim2.fromScale(amount, 0.5)}, 0.07)
			if fire ~= false and callback then
				task.spawn(callback, value)
			end
		end

		local function FromPosition(x)
			local amount = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			Set(minimum + ((maximum - minimum) * amount), true)
		end

		Connect(hitbox.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				activeInput = input
				FromPosition(input.Position.X)
				Tween(thumb, {Size = UDim2.fromOffset(thumbSize + 2, thumbSize + 2)}, 0.08)
			end
		end)

		Connect(UserInputService.InputChanged, function(input)
			local isMouseDrag = activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseMovement
			local isTouchDrag = activeInput and activeInput.UserInputType == Enum.UserInputType.Touch
				and input == activeInput
			if dragging and (isMouseDrag or isTouchDrag) then
				FromPosition(input.Position.X)
			end
		end)

		Connect(UserInputService.InputEnded, function(input)
			local endedMouse = activeInput and activeInput.UserInputType == Enum.UserInputType.MouseButton1
				and input.UserInputType == Enum.UserInputType.MouseButton1
			local endedTouch = activeInput and activeInput.UserInputType == Enum.UserInputType.Touch
				and input == activeInput
			if endedMouse or endedTouch then
				dragging = false
				activeInput = nil
				Tween(thumb, {Size = UDim2.fromOffset(thumbSize, thumbSize)}, 0.08)
			end
		end)

		self.Cursor += rowHeight
		UpdateHeight()
		return {Get = function() return value end, Set = Set}
	end

