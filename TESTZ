local function ActivateCategory(name)
	if not Categories[name] then
		return
	end
	ActiveCategory = name
	for categoryName, category in pairs(Categories) do
		category.Root.Visible = categoryName == name
	end
	for buttonName, data in pairs(Navigation) do
		local active = buttonName == name
		data.Button.BackgroundColor3 = active and Theme.Active or Theme.Sidebar
		data.Icon.ImageColor3 = active and Theme.Accent or Theme.Dim
		data.Label.TextColor3 = active and Theme.Text or Theme.Dim
	end
end

local function GetScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return math.clamp(ResponsiveScale * Settings.UserScale, 0.35, 1.1)
	end
	local viewport = camera.ViewportSize
	local padding = TouchMode and 12 or 24
	local fit = math.min(
		(viewport.X - padding) / Settings.WindowSize.X,
		(viewport.Y - padding) / Settings.WindowSize.Y
	)
	return math.clamp(math.min(ResponsiveScale * Settings.UserScale, fit), 0.35, 1.1)
end

UpdateScale = function(animate)
	local target = GetScale()
	if animate then
		Tween(MainScale, {Scale = target}, 0.16)
		Tween(ShadowScale, {Scale = target}, 0.16)
	else
		MainScale.Scale = target
		ShadowScale.Scale = target
	end
end

local function ClampPosition(position)
	local camera = Workspace.CurrentCamera
	if not camera then
		return position
	end
	local viewport = camera.ViewportSize
	local scale = GetScale()
	local halfWidth = (Settings.WindowSize.X * scale) / 2
	local halfHeight = (Settings.WindowSize.Y * scale) / 2
	local x = (viewport.X * position.X.Scale) + position.X.Offset
	local y = (viewport.Y * position.Y.Scale) + position.Y.Offset
	local minX, maxX = halfWidth + 7, viewport.X - halfWidth - 7
	local minY, maxY = halfHeight + 7, viewport.Y - halfHeight - 7
	x = minX <= maxX and math.clamp(x, minX, maxX) or (viewport.X / 2)
	y = minY <= maxY and math.clamp(y, minY, maxY) or (viewport.Y / 2)
	return UDim2.fromOffset(x, y)
end

local function RecalculateScale()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local padding = TouchMode and 12 or 24
	ResponsiveScale = math.clamp(math.min(
		(viewport.X - padding) / Settings.WindowSize.X,
		(viewport.Y - padding) / Settings.WindowSize.Y,
		1
	), 0.35, 1)
	UpdateScale(false)
	local position = ClampPosition(Main.Position)
	Main.Position = position
	Shadow.Position = position
end

local function BindCamera()
	if CameraConnection then
		CameraConnection:Disconnect()
		CameraConnection = nil
	end
	local camera = Workspace.CurrentCamera
	if camera then
		CameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(RecalculateScale)
	end
	RecalculateScale()
end

local function SetVisible(visible)
	if not Alive or MenuVisible == visible then
		return
	end
	MenuVisible = visible
	if MobileReopenButton then
		MobileReopenButton.Visible = TouchMode and not visible
	end
	if MobileHideButton then
		MobileHideButton.Visible = TouchMode and visible
	end
	local scale = GetScale()
	if visible then
		Main.Visible = true
		Shadow.Visible = true
		Main.GroupTransparency = 1
		MainScale.Scale = scale * 0.975
		Shadow.ImageTransparency = 1
		Tween(Main, {GroupTransparency = 0}, 0.14)
		Tween(MainScale, {Scale = scale}, 0.16, Enum.EasingStyle.Quart)
		Tween(ShadowScale, {Scale = scale}, 0.16, Enum.EasingStyle.Quart)
		Tween(Shadow, {ImageTransparency = 0.28}, 0.14)
	else
		Tween(Shadow, {ImageTransparency = 1}, 0.12)
		Tween(MainScale, {Scale = scale * 0.975}, 0.13)
		Tween(ShadowScale, {Scale = scale * 0.975}, 0.13)
		local hide = Tween(Main, {GroupTransparency = 1}, 0.12)
		task.spawn(function()
			hide.Completed:Wait()
			if Alive and not MenuVisible then
				Main.Visible = false
				Shadow.Visible = false
			end
		end)
	end
end

