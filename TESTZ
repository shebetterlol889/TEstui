local function InitializeKiraAccountState()
    local environment = _G
    if type(getgenv) == "function" then
        local ok, result = pcall(getgenv)
        if ok and type(result) == "table" then
            environment = result
        end
    end

    local function formatDuration(value)
        local seconds = tonumber(value)
        if seconds == math.huge then return "Lifetime" end
        if not seconds then return "Unknown" end
        seconds = math.max(0, math.floor(seconds))
        local days = math.floor(seconds / 86400)
        local hours = math.floor((seconds % 86400) / 3600)
        local minutes = math.floor((seconds % 3600) / 60)
        if days > 0 then return string.format("%dd %dh", days, hours) end
        if hours > 0 then return string.format("%dh %dm", hours, minutes) end
        return string.format("%dm", minutes)
    end

    local function readHardwareId()
        local detectors = {}
        if type(gethwid) == "function" then table.insert(detectors, gethwid) end
        if type(get_hwid) == "function" then table.insert(detectors, get_hwid) end
        if type(gethardwareid) == "function" then table.insert(detectors, gethardwareid) end
        local synTable = rawget(environment, "syn")
        if type(synTable) == "table" and type(synTable.gethwid) == "function" then
            table.insert(detectors, synTable.gethwid)
        end
        for _, detector in ipairs(detectors) do
            local ok, value = pcall(detector)
            value = ok and tostring(value or "") or ""
            if value ~= "" then return value end
        end
        return nil
    end

    local function maskValue(value, fallback, visibleCharacters)
        local rawValue = tostring(value or ""):gsub("%s+", "")
        if rawValue == "" then return fallback end
        local visible = math.max(1, tonumber(visibleCharacters) or 4)
        return string.rep("*", math.max(6, #rawValue - visible)) .. rawValue:sub(-visible)
    end

    local rawScriptKey = rawget(environment, "script_key") or rawget(_G, "script_key")
    environment.KiraAccountInfo = {
        HWIDMasked = maskValue(readHardwareId(), "Luarmor-bound", 6),
        KeyMasked = maskValue(rawScriptKey, "Luarmor-protected", 4),
        KeyDuration = formatDuration(rawget(environment, "LRM_SecondsLeft")),
        KeyLink = "https://ads.luarmor.net/get_key?for=KIRA_HUB-UosmsDxrJxHE",
    }
    return true
end

local KiraAccountOk, KiraAccountResult = pcall(InitializeKiraAccountState)
if not KiraAccountOk then
    warn("[Kira.Win] account-state initialization error: " .. tostring(KiraAccountResult))
end

local function KiraCreateFovCircle(color, style)
    local circle = Drawing.new("Circle")
    circle.Visible = false
    circle.Radius = 100
    circle.Color = color or Color3.fromRGB(227, 48, 72)
    circle.Filled = style == "fill"
    circle.Thickness = style == "fill" and 0 or 2
    circle.Transparency = style == "fill" and 0.14 or 0.95
    pcall(function() circle.NumSides = 96 end)
    pcall(function() circle.ZIndex = style == "fill" and 20 or 21 end)
    return circle
end

