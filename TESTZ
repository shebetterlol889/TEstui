local function CreateNavigationButton(name, iconName, order, desktopY)
	local buttonPosition
	local buttonSize
	if MobilePortrait then
		buttonPosition = UDim2.fromOffset(6 + ((order - 1) * 76), 54)
		buttonSize = UDim2.fromOffset(72, 44)
	elseif TouchMode then
		buttonPosition = UDim2.fromOffset(8, 65 + ((order - 1) * 44))
		buttonSize = UDim2.fromOffset(152, 40)
	else
		buttonPosition = UDim2.fromOffset(10, desktopY)
		buttonSize = UDim2.fromOffset(174, 38)
	end

	local button = New("TextButton", {
		Name = name,
		Position = buttonPosition,
		Size = buttonSize,
		BackgroundColor3 = Theme.Sidebar,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 5,
		Parent = Sidebar,
	})
	Corner(button, 6)

	local icon = Icon(button, iconName, {
		Name = "Icon",
		AnchorPoint = MobilePortrait and Vector2.new(0.5, 0) or Vector2.zero,
		Position = MobilePortrait and UDim2.new(0.5, 0, 0, 5)
			or (TouchMode and UDim2.fromOffset(16, 11) or UDim2.fromOffset(18, 10)),
		Size = UDim2.fromOffset(18, 18),
		ImageColor3 = Theme.Dim,
		ZIndex = 6,
	})

	local textLabel = Label(button, {
		Name = "Text",
		Position = MobilePortrait and UDim2.fromOffset(0, 25)
			or (TouchMode and UDim2.fromOffset(47, 0) or UDim2.fromOffset(49, 0)),
		Size = MobilePortrait and UDim2.new(1, 0, 0, 17) or UDim2.new(1, -55, 1, 0),
		Font = Enum.Font.GothamMedium,
		Text = name,
		TextColor3 = Theme.Dim,
		TextSize = MobilePortrait and 9 or 12,
		TextXAlignment = MobilePortrait and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
		ZIndex = 6,
	})

	Navigation[name] = {
		Button = button,
		Icon = icon,
		Label = textLabel,
	}

	Connect(button.MouseEnter, function()
		if ActiveCategory ~= name then
			Tween(button, {BackgroundColor3 = Theme.Hover})
		end
	end)

	Connect(button.MouseLeave, function()
		if ActiveCategory ~= name then
			Tween(button, {BackgroundColor3 = Theme.Sidebar})
		end
	end)

	Connect(button.Activated, function()
		if Categories[name] then
			ActiveCategory = name
			for categoryName, category in pairs(Categories) do
				category.Root.Visible = categoryName == name
			end
			for buttonName, data in pairs(Navigation) do
				local active = buttonName == name
				Tween(data.Button, {
					BackgroundColor3 = active and Theme.Active or Theme.Sidebar,
				})
				Tween(data.Icon, {
					ImageColor3 = active and Theme.Accent or Theme.Dim,
				})
				Tween(data.Label, {
					TextColor3 = active and Theme.Text or Theme.Dim,
				})
			end
		end
	end)

	return button
end

